# Safe Jarvis environment template — placeholders only.
# Do not put passwords, OAuth tokens, API secrets, bot tokens, or real keys here.
# Every VITE_* value is public in the browser bundle.

# Supabase public project settings (enable and test owner-scoped RLS first)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Local Windows worker: secure mailbox connector + durable task runner.
# It is NOT a local language model. Bind to loopback and use outbound HTTPS only.
JARVIS_LOCAL_API_URL=http://127.0.0.1:8000

# Gemini Developer API is the only planned LLM provider.
# Use the eligible free tier only; no billing link and no paid fallback.
JARVIS_AI_PROVIDER=gemini
JARVIS_GEMINI_MODEL=gemini-3.5-flash-lite
JARVIS_GEMINI_FREE_TIER_ONLY=true
JARVIS_GEMINI_RUNTIME_ENABLED=false # enable in secure Settings after free-tier project/key setup
JARVIS_GEMINI_PRIVATE_DATA_ALLOWED=false
JARVIS_GEMINI_PAID_FALLBACK=false
# GEMINI_API_KEY is intentionally absent; store it only in Windows Credential Manager.

# First mailbox is configured in Jarvis Settings; never place the actual address
# or credentials in this template. Start with read-only IMAP intake only.
JARVIS_MAILBOX_PROVIDER=hostinger
JARVIS_INBOX_READ_ONLY=true
JARVIS_INBOX_POLLING_ENABLED=false # enable after verified secure IMAP setup
JARVIS_OUTBOUND_ENABLED=false     # every external send requires exact approval
JARVIS_LIVE_SCRAPING_ENABLED=false # enable only for reviewed, allowed public sources

# Optional behavior
JARVIS_ENV=development
JARVIS_DENTAL_TARGET_COUNTRIES=US,CA

# Intentionally omitted: never set these in this file or Vite frontend config:
# GEMINI_API_KEY
# HOSTINGER_PASSWORD / SMTP_PASSWORD / IMAP_PASSWORD / app passwords
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY / SUPABASE_DB_PASSWORD
# OAuth client secrets or refresh tokens
# TELEGRAM_BOT_TOKEN
# STRIPE_SECRET_KEY / webhook signing secret
# CLOUDFLARE_API_TOKEN / Git provider token
# Enter connection secrets only through provider OAuth or Jarvis's masked
# Windows Settings flow; persist them in Windows Credential Manager.